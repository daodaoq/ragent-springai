<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ragent</groupId>
        <artifactId>ragent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ragent-ai</artifactId>
    <name>ragent-ai</name>
    <description>Spring AI 集成模块（LLM / RAG / Agent）</description>

    <dependencies>
        <!-- 本模块共享：统一响应 / 异常 / 分页 -->
        <dependency>
            <groupId>com.ragent</groupId>
            <artifactId>ragent-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web（MultipartFile / RestClient / ServerSentEvent） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Redis 多轮会话记忆 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 知识库实体 + Mapper -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- OpenAI starter 对接 DeepSeek（DeepSeek API 与 OpenAI 兼容，只需覆盖 base-url 与模型名） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- 向量库 Qdrant -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
        </dependency>
        <!-- PDF 文档解析 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
