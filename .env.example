# ============================================
# ragent 环境变量示例（P8-8d）
# 复制为 .env 并填入真实值；docker-compose 与 backend application.yml 均从这里取值。
# 严禁把真实 .env 提交到 git（已 gitignore *.env）。
# ============================================

# ---- LLM / 向量 / 重排 ----
# DeepSeek 对话模型 Key（application-local.yml 的 spring.ai.openai.api-key）
DEEPSEEK_API_KEY=
# 阿里百炼 DashScope Key（向量 text-embedding-v3 + 重排 gte-rerank-v2 共用）
DASHSCOPE_API_KEY=

# ---- MinIO 对象存储（docker-compose 与 application.yml 的 MINIO_* 对应）----
# 生产环境务必覆盖默认的 minioadmin/minioadmin
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://localhost:9000

# ---- MySQL（docker-compose 首次初始化使用；已有数据卷时改密码不生效）----
# MYSQL_ROOT_PASSWORD=

# ---- ELK ----
# LOGSTASH_HOST=localhost

# ---- 说明 ----
# backend/ragent-web/src/main/resources/application-local.yml（gitignored）中写死了
# DeepSeek/DashScope 的真实 Key 作为 fallback，属于历史遗留风险：请用环境变量覆盖并清掉默认值。
# 启动：JAVA_HOME="D:/jdk/jdk21" mvn -pl ragent-web -am spring-boot:run
